#!/usr/bin/expect -f

set timeout 60
set password "Photoshop09@"
set host "root@72.61.231.187"

spawn ssh -o StrictHostKeyChecking=no -o PubkeyAuthentication=no $host

expect {
    "password:" { send "$password\r" }
}

expect "# " { send "pm2 list\r" }
expect "# " { send "pm2 logs grekam-os-web --lines 30 --nostream\r" }
expect "# " { send "pm2 logs grekam-os-api --lines 15 --nostream\r" }
expect "# " { send "exit\r" }
expect eof
