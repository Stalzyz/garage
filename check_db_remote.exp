#!/usr/bin/expect -f

set timeout 30
set password "Photoshop09@"
set host "root@72.61.231.187"

spawn ssh -o StrictHostKeyChecking=no -o PubkeyAuthentication=no $host

expect {
    "password:" { send "$password\r" }
}

expect "# " { send "cd /root/grekam-os\r" }
expect "# " { send "cat .env\r" }
expect "# " { send "cat apps/web/.env.local\r" }
expect "# " { send "cat packages/db/.env\r" }
expect "# " { send "exit\r" }
expect eof
