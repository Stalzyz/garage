#!/usr/bin/expect -f
set timeout 60
set host "200.97.163.236"
set user "root"
set password "Photoshop09@"

spawn ssh -o StrictHostKeyChecking=no -o IdentitiesOnly=yes -o PubkeyAuthentication=no $user@$host

expect "password:"
send "$password\r"
expect "# "

# Query User table in postgres garage DB
send "PGPASSWORD='garage_pass_2026' psql -h localhost -U garage -d garage -c 'SELECT id, email, name, role, \"createdAt\" FROM \"User\";'\r"
expect "# "

send "exit\r"
expect eof
