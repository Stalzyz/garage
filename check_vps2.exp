#!/usr/bin/expect -f
set timeout 60
spawn ssh -o StrictHostKeyChecking=no -o PubkeyAuthentication=no root@72.61.231.187 "find /root/grekam-os/apps/web -name '*.js' -path '*/_next/static*' 2>/dev/null | head -3; echo '---'; ls /root/grekam-os/apps/web/.next/ 2>/dev/null; echo '---'; cat /root/vps_script.sh | grep -A5 'os-web'"
expect "assword:"
send "$env(VPS_PASSWORD)"
expect eof
