#!/usr/bin/expect -f
set timeout 60
set host "200.97.163.236"
set user "root"
set password "Photoshop09@"

spawn ssh -o StrictHostKeyChecking=no -o IdentitiesOnly=yes -o PubkeyAuthentication=no $user@$host

expect "password:"
send "$password\r"
expect "# "

# Copy fresh static files to standalone
send "cp -r /var/www/garage_saas/apps/web/.next/static /var/www/garage_saas/apps/web/.next/standalone/apps/web/.next/static 2>&1 && echo 'Static files synced'\r"
expect "# "

# Restart garage-web
send "pm2 restart garage-web && pm2 status\r"
expect "# "

# Test onboarding page route
send "curl -s -o /dev/null -w '%{http_code}' -H 'Host: garage.grekam.in' https://127.0.0.1:443/dashboard/reseller/onboarding -k && echo ' <- onboarding page status'\r"
expect "# "

send "exit\r"
expect eof
