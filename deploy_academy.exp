#!/usr/bin/expect -f

set timeout 600
set password $env(VPS_PASSWORD)
set host "root@200.97.163.236"

spawn ssh -o StrictHostKeyChecking=no -o PubkeyAuthentication=no $host

expect {
    "password:" { send "$password" }
    "yes/no" { send "yes"; exp_continue }
}

expect "# " { send "echo '=== CONNECTED ==='" }
expect "# " { send "cd /root/grekam-os" }
expect "# " { send "git pull origin main 2>&1" }
expect "# " { send "echo '=== PULLED ==='" }
expect "# " { send "docker compose -f docker-compose.prod.vps.yml build academy-web --no-cache 2>&1" }
expect -timeout 600 "# " { send "echo '=== BUILD DONE ==='" }
expect "# " { send "docker compose -f docker-compose.prod.vps.yml up -d --no-deps academy-web 2>&1" }
expect "# " { send "echo '=== DEPLOY DONE ==='" }
expect "# " { send "docker compose -f docker-compose.prod.vps.yml ps" }
expect "# " { send "exit" }
expect eof
