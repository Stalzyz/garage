#!/usr/bin/expect -f
set timeout 600
spawn ssh -o StrictHostKeyChecking=no -o PubkeyAuthentication=no root@72.61.231.187
expect "password:"
send "$env(VPS_PASSWORD)\r"
expect "# "
send "cd /root/grekam-os\r"
expect "# "
send "git pull\r"
expect "# "
send "pnpm install\r"
expect "# "
# Rebuild and restart API
send "cd apps/api && npm run build\r"
expect "# "
send "pm2 restart grekam-os-api\r"
expect "# "
# Rebuild and restart Academy Web
send "cd /root/grekam-os/apps/academy-web && TURBOPACK=0 npm run build\r"
expect "# "
send "pm2 restart academy-web\r"
expect "# "
send "exit\r"
expect eof
