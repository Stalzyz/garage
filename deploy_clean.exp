#!/usr/bin/expect -f

set timeout 900
set password "Photoshop09@"
set host "root@72.61.231.187"

spawn ssh -o StrictHostKeyChecking=no -o PubkeyAuthentication=no $host

expect {
    "password:" { send "$password\r" }
}

# Navigate to monorepo and pull latest changes
expect "# " { send "cd /root/grekam-os\r" }
expect "# " { send "git pull origin main\r" }
expect "# " { send "echo '=== PULL DONE ==='\r" }

# Regenerate Prisma Client
expect "# " { send "pnpm --filter=@grekam/db exec prisma generate\r" }
expect "# " { send "echo '=== PRISMA GENERATE DONE ==='\r" }

# Build api
expect "# " { send "pnpm --filter=@grekam/api build\r" }
expect -timeout 300 "# " { send "echo '=== API BUILD DONE ==='\r" }

# Build web
expect "# " { send "pnpm --filter=@grekam/web build\r" }
expect -timeout 600 "# " { send "echo '=== WEB BUILD DONE ==='\r" }

# Copy standalone build static assets & docs
expect "# " { send "mkdir -p apps/web/.next/standalone/apps/web/.next/\r" }
expect "# " { send "cp -rf apps/web/.next/static apps/web/.next/standalone/apps/web/.next/ || true\r" }
expect "# " { send "cp -rf apps/web/public apps/web/.next/standalone/apps/web/ || true\r" }
expect "# " { send "cp -rf docs apps/web/.next/standalone/apps/web/docs || true\r" }
expect "# " { send "echo '=== COPY STATIC DONE ==='\r" }

# Restart PM2 processes
expect "# " { send "pm2 restart grekam-os-api\r" }
expect "# " { send "pm2 restart grekam-os-web\r" }
expect "# " { send "echo '=== RESTART DONE ==='\r" }

# Check pm2 list
expect "# " { send "pm2 list\r" }
expect "# " { send "exit\r" }
expect eof
