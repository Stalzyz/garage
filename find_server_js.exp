#!/usr/bin/expect -f

set timeout 30
set password "Photoshop09@"
set host "root@72.61.231.187"

spawn ssh -o StrictHostKeyChecking=no -o PubkeyAuthentication=no $host

expect {
    "password:" { send "$password\r" }
}

expect -re "(#|~#|\\$) "
sleep 2

send "find /root/grekam-os/apps/web/.next/standalone -name 'server.js'\r"
expect -re "(#|~#|\\$) "

send "exit\r"
expect eof
