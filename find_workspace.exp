#!/usr/bin/expect -f

set timeout 60
set password "Photoshop09@"
set host "root@200.97.163.236"

spawn ssh -o StrictHostKeyChecking=no -o PubkeyAuthentication=no $host

expect {
    "password:" { send "$password\r" }
    "yes/no" { send "yes\r"; exp_continue }
}

expect "# " { send "find / -name pnpm-workspace.yaml 2>/dev/null\r" }
expect "# " { send "exit\r" }
expect eof
