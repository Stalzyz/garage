#!/usr/bin/expect -f
set timeout 120
set host "200.97.163.236"
set user "root"
set password "Photoshop09@"

spawn ssh -o StrictHostKeyChecking=no -o IdentitiesOnly=yes -o PubkeyAuthentication=no $user@$host

expect "password:"
send "$password\r"
expect "# "

# Create uploads directory
send "mkdir -p /var/www/garage_saas/apps/api/uploads && echo 'uploads dir created'\r"
expect "# "

# Check if standalone build exists
send "ls /var/www/garage_saas/apps/web/.next/standalone/ 2>&1 | head -10\r"
expect "# "

# Write corrected ecosystem.config.js directly on VPS
send {cat > /var/www/garage_saas/ecosystem.config.js << 'ECOEOF'
module.exports = {
  apps: [
    {
      name: "garage-api",
      cwd: "/var/www/garage_saas/apps/api",
      script: "npx",
      args: "tsx src/app.ts",
      env: {
        NODE_ENV: "production",
        PORT: "4000",
        DATABASE_URL: "postgresql://garage:garage_pass_2026@localhost:5432/garage",
        JWT_SECRET: "super-secret-production-key-garage-saas-2026",
        NEXT_PUBLIC_API_URL: "https://garage.grekam.in/api/v1",
        PUPPETEER_SKIP_DOWNLOAD: "true"
      }
    },
    {
      name: "garage-web",
      cwd: "/var/www/garage_saas/apps/web/.next/standalone/apps/web",
      script: "server.js",
      env: {
        NODE_ENV: "production",
        PORT: "3005",
        HOSTNAME: "0.0.0.0",
        NEXT_PUBLIC_API_URL: "https://garage.grekam.in/api/v1",
        JWT_SECRET: "super-secret-production-key-garage-saas-2026"
      }
    }
  ]
};
ECOEOF
}
expect "# "
send "echo 'ecosystem.config.js written'\r"
expect "# "

# Copy static files to standalone (required for standalone mode)
send "cp -r /var/www/garage_saas/apps/web/.next/static /var/www/garage_saas/apps/web/.next/standalone/apps/web/.next/static 2>&1 && echo 'static copied'\r"
expect "# "
send "cp -r /var/www/garage_saas/apps/web/public /var/www/garage_saas/apps/web/.next/standalone/apps/web/public 2>&1 && echo 'public copied'\r"
expect "# "

# Restart PM2 with new config
send "cd /var/www/garage_saas && pm2 delete garage-web && pm2 start ecosystem.config.js --only garage-web && pm2 status\r"
expect "# "

# Wait and test
send "sleep 8 && curl -s -o /dev/null -w '%{http_code}' http://127.0.0.1:3005 && echo ' <- WEB health'\r"
expect "# "

send "pm2 logs garage-web --lines 20 --nostream 2>&1\r"
expect "# "

send "exit\r"
expect eof
