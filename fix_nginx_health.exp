#!/usr/bin/expect -f
set timeout 60
set host "200.97.163.236"
set user "root"
set password "Photoshop09@"

spawn ssh -o StrictHostKeyChecking=no -o IdentitiesOnly=yes -o PubkeyAuthentication=no $user@$host

expect "password:"
send "$password\r"
expect "# "

# Add /health location to nginx config
send "sed -i 's|location /api/v1/ {|location /health {\n        proxy_pass http://127.0.0.1:4000/health;\n        proxy_set_header Host \$host;\n    }\n\n    location /api/v1/ {|' /etc/nginx/sites-available/garage.grekam.in && echo 'health route added'\r"
expect "# "

send "nginx -t && systemctl reload nginx && echo 'Nginx OK'\r"
expect "# "

# Test all paths
send "curl -s http://127.0.0.1:4000/health | head -1 && echo ' <- direct API health'\r"
expect "# "

send "curl -s -H 'Host: garage.grekam.in' http://127.0.0.1/health && echo ' <- nginx health'\r"
expect "# "

send "curl -s -o /dev/null -w '%{http_code}' -H 'Host: garage.grekam.in' http://127.0.0.1/ && echo ' <- nginx web'\r"
expect "# "

# Test from the public Cloudflare-facing endpoint
send "curl -s -o /dev/null -w '%{http_code}' http://garage.grekam.in/ && echo ' <- public web HTTP'\r"
expect "# "

send "curl -s -o /dev/null -w '%{http_code}' https://garage.grekam.in/ && echo ' <- public web HTTPS (via Cloudflare)'\r"
expect "# "

send "exit\r"
expect eof
