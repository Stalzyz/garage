#!/usr/bin/expect -f
set timeout 900

spawn ssh -o StrictHostKeyChecking=no -o PubkeyAuthentication=no root@72.61.231.187
expect "assword:"
send "Photoshop09@\r"
expect "#"

send "cd /root/grekam-os && git reset --hard && git --no-pager pull origin main && git --no-pager log -1 --oneline\r"
expect "#"

send "rm -rf apps/web/.next apps/academy-web/.next\r"
expect "#"

send "pnpm install --frozen-lockfile\r"
expect "#"

send "pnpm --filter=web build\r"
expect "#"

send "cp -rf apps/web/.next/static apps/web/.next/standalone/apps/web/.next/ 2>/dev/null || true\r"
expect "#"
send "cp -rf apps/web/public apps/web/.next/standalone/apps/web/ 2>/dev/null || true\r"
expect "#"

send "pnpm --filter=@grekam/api build\r"
expect "#"

send "pnpm --filter=academy-web build\r"
expect "#"
send "cp -rf apps/academy-web/.next/static apps/academy-web/.next/standalone/apps/academy-web/.next/ 2>/dev/null || true\r"
expect "#"
send "cp -rf apps/academy-web/public apps/academy-web/.next/standalone/apps/academy-web/ 2>/dev/null || true\r"
expect "#"

send "pm2 restart ecosystem.config.js --update-env\r"
expect "#"

send "pm2 save\r"
expect "#"

send "pm2 status\r"
expect "#"

send "exit\r"
expect eof
