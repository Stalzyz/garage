#!/usr/bin/expect -f
set timeout 60
set host "200.97.163.236"
set user "root"
set password "Photoshop09@"

spawn ssh -o StrictHostKeyChecking=no -o IdentitiesOnly=yes -o PubkeyAuthentication=no $user@$host

expect "password:"
send "$password\r"
expect "# "

send "echo '=== 1. Login Page ===' && curl -s -o /dev/null -w '%{http_code}' https://garage.grekam.in/login && echo ''\r"
expect "# "

send "echo '=== 2. Admin Dashboard ===' && curl -s -o /dev/null -w '%{http_code}' https://garage.grekam.in/dashboard/admin/dashboard && echo ''\r"
expect "# "

send "echo '=== 3. Admin Plans & Pricing ===' && curl -s -o /dev/null -w '%{http_code}' https://garage.grekam.in/dashboard/admin/plans && echo ''\r"
expect "# "

send "echo '=== 4. Admin Garages ===' && curl -s -o /dev/null -w '%{http_code}' https://garage.grekam.in/dashboard/admin/garages && echo ''\r"
expect "# "

send "echo '=== 5. Reseller Dashboard ===' && curl -s -o /dev/null -w '%{http_code}' https://garage.grekam.in/dashboard/reseller && echo ''\r"
expect "# "

send "echo '=== 6. Reseller Onboarding Wizard ===' && curl -s -o /dev/null -w '%{http_code}' https://garage.grekam.in/dashboard/reseller/onboarding && echo ''\r"
expect "# "

send "echo '=== 7. API Health ===' && curl -s http://127.0.0.1:4000/health && echo ''\r"
expect "# "

send "echo '=== 8. Test DB User Count ===' && PGPASSWORD='garage_pass_2026' psql -h localhost -U garage -d garage -c 'SELECT email, role, status FROM users;' && echo ''\r"
expect "# "

send "exit\r"
expect eof
