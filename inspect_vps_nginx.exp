#!/usr/bin/expect -f
set timeout 60
set host "200.97.163.236"
set user "root"
set password "Photoshop09@"

spawn ssh -o StrictHostKeyChecking=no -o IdentitiesOnly=yes -o PubkeyAuthentication=no $user@$host

expect "password:"
send "$password\r"
expect "# "

send "ls -la /etc/nginx/sites-enabled/\r"
expect "# "

send "grep -rn 'server_name' /etc/nginx/sites-enabled/\r"
expect "# "

send "grep -rn 'proxy_pass' /etc/nginx/sites-enabled/\r"
expect "# "

send "exit\r"
expect eof
