#!/usr/bin/expect -f
set timeout 30
spawn ssh -o PubkeyAuthentication=no -o StrictHostKeyChecking=no root@72.61.231.187 {
  for slug in ui_ux_design digital_marketing vfx_compositing graphic_design video_editing_ai 3d_animation motion_graphics fullstack_web_dev wordpress_web_design; do
    code=$(curl -s -o /dev/null -w "%{http_code}" "http://localhost:3006/$slug")
    echo "[$code] /$slug"
  done
  echo "---"
  for slug in gallery contact 404test auth/login auth/forgot-password; do
    code=$(curl -s -o /dev/null -w "%{http_code}" "http://localhost:3006/$slug")
    echo "[$code] /$slug"
  done
}
expect "*?assword:*"
send "Photoshop09@\r"
expect eof
