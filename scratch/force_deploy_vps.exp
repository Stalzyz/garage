#!/usr/bin/expect -f
set timeout 600
spawn ssh -o StrictHostKeyChecking=no -o PubkeyAuthentication=no root@72.61.231.187
expect "assword:"
send "$env(VPS_PASSWORD)\r"
expect "# "
send "cd /root/grekam-os && git fetch origin && git reset --hard origin/main && pnpm --filter=web build\r"
expect "# "
send "cd apps/web && cp -rf .next/static .next/standalone/apps/web/.next/ && cp -rf public .next/standalone/apps/web/ && cd ../..\r"
expect "# "
send "pm2 restart grekam-os-web\r"
expect "# "
send "exit\r"
expect eof
