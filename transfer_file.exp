#!/usr/bin/expect -f
set timeout 120
set host "200.97.163.236"
set user "root"
set password "Photoshop09@"
set src [lindex $argv 0]
set dest [lindex $argv 1]

spawn scp -o StrictHostKeyChecking=no -o IdentitiesOnly=yes -o PubkeyAuthentication=no $src $user@$host:$dest
expect {
    "password:" {
        send "$password\r"
        exp_continue
    }
    eof
}
