#!/usr/bin/expect -f
set timeout 120
set script {
cd /root/grekam-os/packages/db && node -e "
const {PrismaClient}=require('@prisma/client');
const p=new PrismaClient();
p.user.findMany({
  where: { role: 'CLIENT' },
  select: { id: true, email: true, firstName: true, lastName: true, passwordHash: true }
}).then(r=>{
  console.log('Client users:');
  console.log(JSON.stringify(r, null, 2));
  return p.\$disconnect();
});
" 2>&1
}

spawn ssh -o StrictHostKeyChecking=no -o PubkeyAuthentication=no root@72.61.231.187 $script
expect "assword:"
send "Photoshop09@\r"
expect eof
