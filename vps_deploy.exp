#!/usr/bin/expect -f
set timeout 300
set script {
  cd /root/grekam-os
  echo "Current directory: $(pwd)"
  git pull
  pnpm i
  cd packages/db && npx prisma generate && npx prisma db push && cd ../..
  pnpm build:all
  pm2 restart grekam-os-api grekam-os-web --update-env || pm2 restart all
  pm2 save
}
spawn ssh -o StrictHostKeyChecking=no -o PubkeyAuthentication=no root@72.61.231.187 $script
expect "assword:"
send "Photoshop09@\r"
expect eof
