#!/usr/bin/expect -f
set timeout 120
set password "Photoshop09@"
set host "72.61.231.187"

spawn ssh -o StrictHostKeyChecking=no -o IdentitiesOnly=yes -o PreferredAuthentications=password root@$host

expect {
    "passphrase"  { send "\r"; exp_continue }
    "password:"   { send "$password\r" }
    "# "          { }
}

expect "# "
send "cd /root/grekam-os && git pull origin main\r"

expect -timeout 60 "# "
send "echo '=== PULL DONE ==='\r"

expect "=== PULL DONE ==="
expect "# "

send "exit\r"
expect eof
